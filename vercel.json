{
  "rewrites": [
    {
      "source": "/app/",
      "destination": "https://linkup-muqu.vercel.app/index.html"
    },
    {
      "source": "/app",
      "destination": "https://linkup-muqu.vercel.app/index.html"
    },
    {
      "source": "/app/:path*",
      "destination": "https://linkup-muqu.vercel.app/:path*"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
